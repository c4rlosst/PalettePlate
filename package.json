{
  "name": "paletteplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:create": "node scripts/create-local-db.mjs",
    "db:start": "node scripts/start-local-mysql.mjs",
    "mail:start": "node scripts/local-mail.mjs",
    "local:start": "npm run db:start && npm run mail:start && npm run dev -- --hostname 127.0.0.1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-foods.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:local": "docker compose up -d --wait && npm run db:setup",
    "db:dump": "node scripts/backup.mjs dump",
    "db:restore": "node scripts/backup.mjs restore"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "^1.7.19",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.71.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
