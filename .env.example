DATABASE_URL=mysql://APP_USER:APP_PASSWORD@DB_HOST:3306/paletteplate
DATABASE_TLS=false
DATABASE_CA=
DATABASE_POOL_SIZE=3
# Temporary, local bootstrap only; removed by npm run db:create after success.
DATABASE_ADMIN_URL=
MYSQL_BIN=
MYSQLDUMP_BIN=
DATABASE_CA_FILE=
MYSQL_DATABASE=paletteplate
MYSQL_USER=APP_USER
MYSQL_PASSWORD=APP_PASSWORD
MYSQL_ROOT_PASSWORD=ROOT_PASSWORD
MYSQL_PORT=3306
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_URL=http://YOUR_APP_HOST:3000
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PalettePlate <YOUR_SENDER_EMAIL>
# S3-compatible bucket for feed photos (for example a Railway Bucket); server-side only.
STORAGE_ENDPOINT=https://YOUR_BUCKET_ENDPOINT
STORAGE_REGION=auto
STORAGE_BUCKET=YOUR_BUCKET_NAME
STORAGE_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
